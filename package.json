{
  "name": "mnemonic-kb",
  "version": "0.1.0",
  "private": true,
  "description": "Personal developer memory for agentic engineering",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=20" },
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts,.tsx",
    "doctor": "pnpm --filter @mnemonic/cli exec mnemonic doctor",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "typescript": "^5.4.0",
    "tsup": "^8.0.0",
    "tsx": "^4.7.0",
    "vitest": "^1.5.0"
  }
}
